TOX_DEBUG=0
TOX_DESKTOP_MODE=1
TOX_PORT=8765
PORT=
TOX_HOST=127.0.0.1
HOST=
TOX_LAN_ACCESS=0
TOX_SECRET_KEY=tox-dev-secret-key-change-before-production
TOX_ALLOWED_HOSTS=127.0.0.1,localhost
# Production / hosting
TOX_SECRET_KEY=
TOX_DEBUG=0
TOX_DESKTOP_MODE=0
# Railway provides PORT automatically; set DATABASE_URL for Postgres if used
DATABASE_URL=
# If using SQLite with a persistent volume, set path (example: /data/db.sqlite3)
TOX_DB_PATH=
# Static files
TOX_STATIC_ROOT=/data/staticfiles
# Security (set to 1 in production when using HTTPS)
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_PRELOAD=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
